# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/generated-artifacts/
# Offline media-authoring dependencies are not part of the web/API runtime.
/pyproject.toml
/uv.lock
/attached_assets/Screenshot_20261013_*_Lovable_*.jpg
/attached_assets/Screenshot_20261014_000*_Lovable_*.jpg
/attached_assets/Screenshot_20261014_001*_Chrome_*.jpg
